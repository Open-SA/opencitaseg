{
  "name": "opensa/opencitaseg",
  "description": "Plugin para GLPI que permite citar seguimientos.",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "glpi-project/phpstan-glpi": "^1.3",
    "glpi-project/tools": "^0.8",
    "phpstan/phpstan": "^2.2",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "GlpiPlugin\\Opencitaseg\\": "src/"
    }
  }
}
