#. Button label shown next to each follow-up (verb).
msgid "Quote"
msgstr "Citer"

#. Tooltip of the quote button.
msgid "Quote this followup"
msgstr "Citer ce suivi"

#. Header of the inserted quote block. %s = author name.
msgid "Quoting %s"
msgstr "Citation de %s"

#. Fallback author name when it cannot be resolved.
msgid "User"
msgstr "Utilisateur"

#. Type name of the internal citation link object.
msgid "Follow-up quote"
msgid_plural "Follow-up quotes"
msgstr[0] "Citation de suivi"
msgstr[1] "Citations de suivi"


msgid "Follow-up quoted"
msgstr "Suivi cité"

msgid "Author of the quoted follow-up"
msgstr "Auteur du suivi cité"

msgid "User who quoted the follow-up"
msgstr "Utilisateur ayant cité le suivi"

msgid "Date of the quote"
msgstr "Date de la citation"

msgid "Unknown user"
msgstr "Utilisateur inconnu"

#. Entity config: whether the entity inherits its parent's settings.
msgid "Inherit from parent entity"
msgstr "Hériter de l'entité parente"

#. Entity config: master switch for the quote feature.
msgid "Enable quotes"
msgstr "Activer les citations"

#. Entity config: initial value of is_private on a new quote.
msgid "Quotes private by default"
msgstr "Citations privées par défaut"

#. Notice shown when the entity inherits an enabled configuration.
msgid "Quotes are currently enabled through inheritance."
msgstr "Les citations sont actuellement activées par héritage."

#. Notice shown when the entity inherits a disabled configuration.
msgid "Quotes are currently disabled through inheritance."
msgstr "Les citations sont actuellement désactivées par héritage."

#. Tooltip of the quote button on a task.
msgid "Quote this task"
msgstr "Citer cette tâche"