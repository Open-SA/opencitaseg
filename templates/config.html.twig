{% import "components/form/fields_macros.html.twig" as fields %}

<div class="asset">
    <form method="post" action="{{ save_url }}">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <input type="hidden" name="entities_id" value="{{ entities_id }}">

      <div class="card-body">
         <div class="row">
            {% if not is_root %}
               {{ fields.dropdownYesNo(
                  'use_parent_config',
                  use_parent_config,
                  __('Inherit from parent entity', 'opencitaseg')
               ) }}
            {% endif %}

            {{ fields.dropdownYesNo('is_active', is_active, __('Enable quotes', 'opencitaseg')) }}

            {{ fields.dropdownYesNo(
               'default_private',
               default_private,
               __('Quotes private by default', 'opencitaseg')
            ) }}
         </div>

         {% if not is_root and use_parent_config %}
            <div class="alert alert-info">
               {{ resolved_active
                  ? __('Quotes are currently enabled through inheritance.', 'opencitaseg')
                  : __('Quotes are currently disabled through inheritance.', 'opencitaseg') }}
            </div>
         {% endif %}
      </div>

      {% if can_update %}
         <div class="card-footer text-end">
            <button type="submit" name="update" class="btn btn-primary">{{ __('Save') }}</button>
         </div>
      {% endif %}
   </form>
</div>